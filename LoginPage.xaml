<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TutorLocal.LoginPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F9FAFB">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryBlue">#5B44E9</Color>
            <Color x:Key="LightBlueBg">#EEF0FF</Color>
            <Color x:Key="TextDark">#111827</Color>
            <Color x:Key="TextGray">#6B7280</Color>
            <Color x:Key="InputBg">#FFFFFF</Color>
            <Color x:Key="BorderColor">#E5E7EB</Color>
            <Color x:Key="OrangeAccent">#F59E0B</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,30" Spacing="0">

            <!-- HEADER : Bouton Retour et Badge -->
            <Grid ColumnDefinitions="Auto, *" Margin="0,0,0,32">
                <!-- Bouton Retour -->
                <Border WidthRequest="44" HeightRequest="44" BackgroundColor="{StaticResource LightBlueBg}" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackButtonClicked" />
                    </Border.GestureRecognizers>
                    <Label Text="←" TextColor="{StaticResource TextDark}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                
                <!-- Badge Réseau Solidaire -->
                <Border Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" BackgroundColor="{StaticResource LightBlueBg}" StrokeShape="RoundRectangle 20" Padding="12,6" StrokeThickness="0">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <BoxView Color="{StaticResource OrangeAccent}" WidthRequest="8" HeightRequest="8" CornerRadius="4" VerticalOptions="Center" />
                        <Label Text="RÉSEAU SOLIDAIRE" TextColor="{StaticResource TextGray}" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" CharacterSpacing="1"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- ICONE ET TEXTE BIENVENUE -->
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center" Margin="0,0,0,24">
                <Grid WidthRequest="60" HeightRequest="60" HorizontalOptions="Center">
                    <Border WidthRequest="54" HeightRequest="54" BackgroundColor="{StaticResource PrimaryBlue}" StrokeShape="RoundRectangle 16" StrokeThickness="0" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="🎓" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="26"/>
                    </Border>
                    <!-- Petit badge coeur -->
                    <Border WidthRequest="22" HeightRequest="22" BackgroundColor="{StaticResource OrangeAccent}" StrokeShape="RoundRectangle 11" Stroke="White" StrokeThickness="2" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-4,-4">
                        <Label Text="🤍" FontSize="10" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Label Text="Bon retour parmi nous !" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource TextDark}" HorizontalTextAlignment="Center" Margin="0,8,0,0" />
                <Label Text="Connectez-vous pour retrouver vos tuteurs,&#10;vos cours planifiés et vos messages." FontSize="14" TextColor="{StaticResource TextGray}" HorizontalTextAlignment="Center" LineHeight="1.4" />
            </VerticalStackLayout>

            <!-- SELECTEUR TYPE DE COMPTE -->
            <Border BackgroundColor="{StaticResource LightBlueBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="4" Margin="0,0,0,16">
                <Grid ColumnDefinitions="*,*">
                    <!-- Actif -->
                    <Border Grid.Column="0" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="0,12">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="4" Opacity="0.05" />
                        </Border.Shadow>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Label Text="📅" VerticalOptions="Center" FontSize="14" />
                            <Label Text="Élève / Parent" TextColor="{StaticResource PrimaryBlue}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <!-- Inactif -->
                    <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                        <Label Text="🤝" VerticalOptions="Center" FontSize="14" />
                        <Label Text="Tuteur bénévole" TextColor="{StaticResource TextGray}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <!-- BANNIERE INFO -->
            <Border BackgroundColor="{StaticResource LightBlueBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16" Margin="0,0,0,24">
                <Grid ColumnDefinitions="Auto, *">
                    <Label Text="💡" FontSize="18" Margin="0,0,12,0" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Accédez à votre planning de devoirs et tuteurs du quartier." FontSize="13" TextColor="{StaticResource TextGray}" LineHeight="1.3" />
                </Grid>
            </Border>

            <!-- CHAMP : EMAIL -->
            <VerticalStackLayout Spacing="8" Margin="0,0,0,16">
                <Label Text="Adresse email" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextDark}" />
                <Border BackgroundColor="{StaticResource InputBg}" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" HeightRequest="52" Padding="12,0">
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Text="✉️" TextColor="{StaticResource TextGray}" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Placeholder="alex@exemple.fr" Keyboard="Email" BackgroundColor="Transparent" TextColor="{StaticResource TextDark}" Margin="8,0,0,0" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- CHAMP : MOT DE PASSE -->
            <VerticalStackLayout Spacing="8" Margin="0,0,0,24">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Mot de passe" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextDark}" />
                    <Label Grid.Column="1" Text="Mot de passe oublié ?" FontSize="13" TextColor="{StaticResource PrimaryBlue}" FontAttributes="Bold" />
                </Grid>
                <Border BackgroundColor="{StaticResource InputBg}" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" HeightRequest="52" Padding="12,0">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Label Text="🔒" TextColor="{StaticResource TextGray}" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Placeholder="••••••••" IsPassword="True" BackgroundColor="Transparent" TextColor="{StaticResource TextDark}" Margin="8,0,0,0" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="👁️" TextColor="{StaticResource TextGray}" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- OPTIONS CONNEXION (Se souvenir & Biométrie) -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,24">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <CheckBox Color="{StaticResource PrimaryBlue}" IsChecked="True" />
                    <Label Text="Se souvenir de moi" TextColor="{StaticResource TextDark}" FontSize="14" VerticalOptions="Center" />
                </HorizontalStackLayout>
                
                <Border Grid.Column="1" BackgroundColor="{StaticResource LightBlueBg}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="👆" FontSize="12" VerticalOptions="Center"/>
                        <Label Text="Biométrie" TextColor="{StaticResource TextDark}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- BOUTON SE CONNECTER -->
            <Button Text="Se connecter  →" BackgroundColor="{StaticResource PrimaryBlue}" TextColor="White" CornerRadius="12" HeightRequest="52" FontAttributes="Bold" FontSize="16" Margin="0,0,0,24" />

            <!-- SEPARATEUR OU -->
            <Grid ColumnDefinitions="*, Auto, *" VerticalOptions="Center" Margin="0,0,0,24">
                <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="OU CONTINUER AVEC" TextColor="{StaticResource TextGray}" FontSize="11" FontAttributes="Bold" Margin="12,0" />
                <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource BorderColor}" VerticalOptions="Center" />
            </Grid>

            <!-- CONNEXION ENT -->
            <Border BackgroundColor="White" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" Padding="16,12" Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Border WidthRequest="36" HeightRequest="36" BackgroundColor="{StaticResource LightBlueBg}" StrokeThickness="0" StrokeShape="RoundRectangle 8" VerticalOptions="Center" Margin="0,0,12,0">
                        <Label Text="🏛️" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="Éducation Nationale / ENT" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextDark}" />
                        <Label Text="Accès direct EduConnect" FontSize="11" TextColor="{StaticResource TextGray}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource TextGray}" VerticalOptions="Center" FontAttributes="Bold"/>
                </Grid>
            </Border>

            <!-- CONNEXION GOOGLE -->
            <Border BackgroundColor="White" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" Padding="16,12" Margin="0,0,0,24">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Label Text="G" TextColor="#EA4335" FontAttributes="Bold" FontSize="20" VerticalOptions="Center" Margin="8,0,20,0" />
                    <Label Grid.Column="1" Text="Continuer avec Google" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextDark}" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource TextGray}" VerticalOptions="Center" FontAttributes="Bold"/>
                </Grid>
            </Border>

            <!-- BADGE SECURITE -->
            <Border BackgroundColor="{StaticResource LightBlueBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16" Margin="0,0,0,32">
                <Grid ColumnDefinitions="Auto, *">
                    <Label Text="🛡️" FontSize="20" Margin="0,0,12,0" VerticalOptions="Start" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="Espace 100% sécurisé et bénévole" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource TextDark}" />
                        <Label Text="Vos échanges et coordonnées sont protégés. Les tuteurs sont vérifiés par l'équipe." FontSize="11" TextColor="{StaticResource TextGray}" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- FOOTER INSCRIPTION -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Padding="0,0,0,20">
                <Label Text="Pas encore inscrit ?" TextColor="{StaticResource TextGray}" FontSize="14" VerticalOptions="Center"/>
                <Label Text="Créer un compte →" TextColor="{StaticResource PrimaryBlue}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavigateToRegister" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>