<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TutorLocal.ViewModels"
             x:Class="TutorLocal.Views.RequestHelpPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F9FAFB">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryBlue">#5B44E9</Color>
            <Color x:Key="LightBlueBg">#EEF0FF</Color>
            <Color x:Key="TextDark">#111827</Color>
            <Color x:Key="TextGray">#6B7280</Color>
            <Color x:Key="GreenSuccess">#10B981</Color>
            <Color x:Key="OrangeWarning">#F59E0B</Color>
            <Color x:Key="CardBg">#FFFFFF</Color>
            <Color x:Key="BorderColor">#E5E7EB</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- HEADER FIXE (Navigation) -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,20,20,10" BackgroundColor="{StaticResource CardBg}">
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Label Text="←" FontSize="24" TextColor="{StaticResource TextDark}" VerticalOptions="Center">
                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding BackCommand}" /></Label.GestureRecognizers>
                </Label>
                <Label Text="Demande De Cours" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextDark}" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Border Grid.Column="2" WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="{StaticResource PrimaryBlue}" VerticalOptions="Center"/>
        </Grid>

        <!-- FORMULAIRE DEFILANT -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,40" Spacing="24">

                <!-- EN-TETE FORMULAIRE -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Besoin d'aide ?" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource TextDark}" />
                        <Border Grid.Column="1" BackgroundColor="#34D399" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,6" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="✓" TextColor="#064E3B" FontAttributes="Bold" FontSize="11" />
                                <Label Text="100% Gratuit" TextColor="#064E3B" FontAttributes="Bold" FontSize="12" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <Label Text="Formulez votre question pour que les tuteurs disponibles dans votre secteur puissent vous proposer une séance." FontSize="14" TextColor="{StaticResource TextGray}" LineHeight="1.4" />
                </VerticalStackLayout>

                <!-- BANNIERE MENTORS ACTIFS -->
                <Border BackgroundColor="{StaticResource LightBlueBg}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="16">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <!-- Avatars superposés (Simulation) -->
                        <Grid WidthRequest="60" Margin="0,0,12,0" VerticalOptions="Center">
                            <Border WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" StrokeThickness="2" Stroke="White" BackgroundColor="{StaticResource PrimaryBlue}" Opacity="0.7" HorizontalOptions="Start"/>
                            <Border WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" StrokeThickness="2" Stroke="White" BackgroundColor="{StaticResource PrimaryBlue}" Opacity="0.85" HorizontalOptions="Center"/>
                            <Border WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" StrokeThickness="2" Stroke="White" BackgroundColor="{StaticResource PrimaryBlue}" HorizontalOptions="End"/>
                        </Grid>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label FontSize="12" TextColor="{StaticResource TextDark}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="14 mentors " TextColor="{StaticResource PrimaryBlue}" FontAttributes="Bold"/>
                                        <Span Text="actifs près de chez vous" FontAttributes="Bold" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="Temps de réponse moyen : ~18 min" FontSize="11" TextColor="{StaticResource TextGray}" />
                        </VerticalStackLayout>
                        <BoxView Grid.Column="2" Color="#059669" WidthRequest="10" HeightRequest="10" CornerRadius="5" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- CHAMP : MATIERE & NIVEAU -->
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Matière &amp; Niveau" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextDark}" />
                        <Label Grid.Column="1" Text="Requis" TextColor="{StaticResource PrimaryBlue}" FontAttributes="Bold" FontSize="11" />
                    </Grid>
                    <Border BackgroundColor="{StaticResource CardBg}" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" Padding="12,12">
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ChooseSubjectLevelCommand}" /></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="{Binding SubjectLevelLabel}" TextColor="{StaticResource TextDark}" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="▼" TextColor="{StaticResource TextGray}" FontSize="12" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- CHAMP : DESCRIPTION -->
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Décrivez votre difficulté ou chapitre" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextDark}" />
                        <Label Grid.Column="1" Text="{Binding DescriptionCountLabel}" TextColor="{StaticResource TextGray}" FontSize="11" />
                    </Grid>
                    <Border BackgroundColor="{StaticResource CardBg}" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 16" Padding="16">
                        <VerticalStackLayout Spacing="16">
                            <Editor Text="{Binding Description}" Placeholder="Décrivez votre difficulté ou chapitre à réviser..." TextColor="{StaticResource TextDark}" BackgroundColor="Transparent" FontSize="14" AutoSize="TextChanges" />
                            
                            <!-- Bouton pièce jointe intégré -->
                            <Border BackgroundColor="{StaticResource LightBlueBg}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8" HorizontalOptions="Start">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding AttachFileCommand}" /></Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding AttachmentButtonLabel}" TextColor="{StaticResource PrimaryBlue}" FontAttributes="Bold" FontSize="12" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- CHAMP : NIVEAU URGENCE (Cards selectionnables) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Niveau d'urgence" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextDark}" />
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <!-- Option : Urgent -->
                        <Border Grid.Column="0" BackgroundColor="{Binding IsUrgentSelected, Converter={StaticResource UrgentChipBg}}" StrokeThickness="1" Stroke="{Binding IsUrgentSelected, Converter={StaticResource UrgentChipStroke}}" StrokeShape="RoundRectangle 12" Padding="12">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectUrgentCommand}" /></Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border BackgroundColor="{StaticResource OrangeWarning}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="6,2">
                                        <HorizontalStackLayout Spacing="4"><Label Text="Urgent" TextColor="White" FontSize="10" FontAttributes="Bold"/></HorizontalStackLayout>
                                    </Border>
                                    <!-- Radio : actif si Urgent sélectionné -->
                                    <Border Grid.Column="1" WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8" StrokeThickness="2" Stroke="{Binding IsUrgentSelected, Converter={StaticResource UrgentChipStroke}}" HorizontalOptions="End">
                                        <BoxView Color="#F59E0B" WidthRequest="8" HeightRequest="8" CornerRadius="4" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsUrgentSelected}"/>
                                    </Border>
                                </Grid>
                                <Label Text="Aujourd'hui" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextDark}" Margin="0,4,0,0"/>
                                <Label Text="Sous 24h" FontSize="12" TextColor="#B45309" />
                            </VerticalStackLayout>
                        </Border>
                        
                        <!-- Option : Planifié -->
                        <Border Grid.Column="1" BackgroundColor="{Binding IsPlannedSelected, Converter={StaticResource PlannedChipBg}}" StrokeThickness="1" Stroke="{Binding IsPlannedSelected, Converter={StaticResource UrgentChipStroke}}" StrokeShape="RoundRectangle 12" Padding="12">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectPlannedCommand}" /></Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border BackgroundColor="{StaticResource LightBlueBg}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="6,2">
                                        <HorizontalStackLayout Spacing="4"><Label Text="Planifié" TextColor="{StaticResource TextDark}" FontSize="10" FontAttributes="Bold"/></HorizontalStackLayout>
                                    </Border>
                                    <!-- Radio : actif si Planifié sélectionné -->
                                    <Border Grid.Column="1" WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8" StrokeThickness="2" Stroke="{Binding IsPlannedSelected, Converter={StaticResource UrgentChipStroke}}" HorizontalOptions="End">
                                        <BoxView Color="#5B44E9" WidthRequest="8" HeightRequest="8" CornerRadius="4" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsPlannedSelected}"/>
                                    </Border>
                                </Grid>
                                <Label Text="Cette semaine" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextDark}" Margin="0,4,0,0"/>
                                <Label Text="Créneau flexible" FontSize="12" TextColor="{StaticResource TextGray}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- CHAMP : MODALITE -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Modalité souhaitée" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextDark}" />
                    <Border BackgroundColor="{StaticResource LightBlueBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="4">
                        <Grid ColumnDefinitions="*,*">
                            <!-- En présentiel (état lié au VM) -->
                            <Border Grid.Column="0" BackgroundColor="{Binding IsInPersonSelected, Converter={StaticResource SegActiveBg}}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="0,12">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectInPersonCommand}" /></Border.GestureRecognizers>
                                <Border.Shadow><Shadow Brush="#000000" Offset="0,2" Radius="4" Opacity="0.05" /></Border.Shadow>
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                                    <Label Text="En présentiel" TextColor="{Binding IsInPersonSelected, Converter={StaticResource SegText}}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Text="✓" TextColor="{StaticResource GreenSuccess}" FontAttributes="Bold" VerticalOptions="Center" FontSize="12" IsVisible="{Binding IsInPersonSelected}"/>
                                </HorizontalStackLayout>
                            </Border>
                            <!-- En visio (état lié au VM) -->
                            <Border Grid.Column="1" BackgroundColor="{Binding IsOnlineSelected, Converter={StaticResource SegActiveBg}}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="0,12">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectOnlineCommand}" /></Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                                    <Label Text="En visio" TextColor="{Binding IsOnlineSelected, Converter={StaticResource SegText}}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Text="✓" TextColor="{StaticResource GreenSuccess}" FontAttributes="Bold" VerticalOptions="Center" FontSize="12" IsVisible="{Binding IsOnlineSelected}"/>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- CARTE : LIEU RECOMMANDE -->
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Lieu d'échange public recommandé" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextDark}" />
                        <Label Grid.Column="1" Text="Modifier" TextColor="{StaticResource PrimaryBlue}" FontAttributes="Bold" FontSize="11">
                            <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding EditMeetingPlaceCommand}" /></Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Border BackgroundColor="{StaticResource CardBg}" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 16" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding MeetingPlaceLabel}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextDark}" />
                                    <Label Text="✓" TextColor="#064E3B" FontAttributes="Bold" FontSize="12" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding MeetingPlaceDistance}" FontSize="12" TextColor="{StaticResource TextGray}" />
                            </VerticalStackLayout>
                            
                            <!-- Mini Map intégrée dans la carte -->
                            <Border BackgroundColor="#E5E7EB" HeightRequest="100" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                <Grid>
                                    <Image Source="map_background.jpg" Aspect="AspectFill" />
                                    <!-- Label de sécurité superposé sur la carte -->
                                    <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,4" HorizontalOptions="Start" VerticalOptions="End" Margin="8">
                                        <HorizontalStackLayout Spacing="4"><Label Text="Espace public sécurisé" FontAttributes="Bold" FontSize="10" TextColor="{StaticResource TextDark}"/></HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ENCART INFO SÉCURITÉ BAS DE PAGE -->
                <Border BackgroundColor="{StaticResource LightBlueBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16" Margin="0,0,0,20">
                    <Label Text="Tous les cours sont gratuits et dispensés par des bénévoles certifiés dans des tiers-lieux partenaires ou en visioconférence surveillée." FontSize="12" TextColor="{StaticResource TextGray}" LineHeight="1.3" />
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- FOOTER FIXE (Bouton d'action Sticky) -->
        <Border Grid.Row="2" BackgroundColor="{StaticResource CardBg}" StrokeThickness="1" Stroke="#E5E7EB" Padding="20,16,20,30" Margin="-1,0,-1,-1">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding ErrorMessage}" TextColor="#B91C1C" FontSize="12" IsVisible="{Binding HasError}" />
            <Button Text="Publier ma demande d'aide" Command="{Binding PublishCommand}" BackgroundColor="{StaticResource PrimaryBlue}" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="52" FontSize="15" />
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>