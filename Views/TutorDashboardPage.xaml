<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TutorLocal.ViewModels"
             x:Class="TutorLocal.Views.TutorDashboardPage"
             x:DataType="vm:TutorDashboardViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F9FAFB">
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="20" ColumnDefinitions="*,Auto,Auto" BackgroundColor="White">
            <VerticalStackLayout>
                <Label Text="Espace tuteur" FontSize="22" FontAttributes="Bold" TextColor="#111827" />
                <Label Text="{Binding TutorName}" FontSize="14" TextColor="#6B7280" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Notifications" Command="{Binding OpenNotificationsCommand}"
                    BackgroundColor="#EEF0FF" TextColor="#4338CA"
                    FontSize="14" />
            <Button Grid.Column="2" Text="Se déconnecter" Command="{Binding LogoutCommand}"
                    BackgroundColor="#EEF0FF" TextColor="#4338CA" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">
                <Label Text="Demandes à traiter" FontSize="20" FontAttributes="Bold" TextColor="#111827" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding IncomingRequests}" Spacing="12">
                    <BindableLayout.EmptyView>
                        <Label Text="Aucune nouvelle demande pour le moment." TextColor="#6B7280" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:TutorRequestCardViewModel">
                            <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16" Padding="16">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding SubjectLine}" FontAttributes="Bold" TextColor="#111827" />
                                        <Label Grid.Column="1" Text="{Binding ScheduleLabel}" TextColor="#4338CA" />
                                    </Grid>
                                    <Label Text="{Binding Request.Description}" TextColor="#374151" />
                                    <Label Text="{Binding ModalityLabel}" FontSize="12" TextColor="#6B7280" />
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <Button Text="Accepter" Command="{Binding AcceptCommand}"
                                                BackgroundColor="#059669" TextColor="White" />
                                        <Button Grid.Column="1" Text="Refuser" Command="{Binding RejectCommand}"
                                                BackgroundColor="#F3F4F6" TextColor="#374151" />
                                        <Button Grid.Column="2" Text="Message" Command="{Binding MessageCommand}"
                                                BackgroundColor="#EEF0FF" TextColor="#4338CA" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
