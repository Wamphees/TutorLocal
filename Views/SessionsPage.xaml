<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TutorLocal.SessionsPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F9FAFB">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryBlue">#5B44E9</Color>
            <Color x:Key="LightBlueBg">#EEF0FF</Color>
            <Color x:Key="TextDark">#111827</Color>
            <Color x:Key="TextGray">#6B7280</Color>
            <Color x:Key="GreenSuccess">#10B981</Color>
            <Color x:Key="OrangeWarning">#F59E0B</Color>
            <Color x:Key="RedDanger">#EF4444</Color>
            <Color x:Key="CardBg">#FFFFFF</Color>
            <Color x:Key="BorderColor">#E5E7EB</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- HEADER FIXE (Ligne du haut) -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto" Padding="20,20,20,10" BackgroundColor="{StaticResource CardBg}">
            <!-- Logo miniature -->
            <Border WidthRequest="28" HeightRequest="28" BackgroundColor="{StaticResource LightBlueBg}" StrokeShape="RoundRectangle 8" StrokeThickness="0" VerticalOptions="Center">
                <Label Text="📘" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <Label Grid.Column="1" Text="TutorLocal" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextDark}" VerticalOptions="Center" Margin="8,0,0,0" />
            
            <!-- Notification -->
            <Label Grid.Column="2" Text="🔔" FontSize="20" VerticalOptions="Center" Margin="0,0,16,0" />
            
            <!-- Avatar Profil -->
            <Border Grid.Column="3" WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="#E5E7EB" VerticalOptions="Center">
                <Label Text="👤" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </Grid>

        <!-- CONTENU DÉFILANT -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,10,20,40" Spacing="20">

                <!-- TITRE & BOUTONS RECHERCHE/FILTRE -->
                <Grid ColumnDefinitions="*, Auto, Auto">
                    <VerticalStackLayout VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Mes séances" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextDark}" />
                            <Border BackgroundColor="{StaticResource PrimaryBlue}" WidthRequest="24" HeightRequest="24" StrokeShape="RoundRectangle 12" StrokeThickness="0" VerticalOptions="Center">
                                <Label Text="3" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </HorizontalStackLayout>
                        <Label Text="Accompagnement et révisions solidaires" FontSize="13" TextColor="{StaticResource TextGray}" />
                    </VerticalStackLayout>
                    
                    <Border Grid.Column="1" BackgroundColor="{StaticResource LightBlueBg}" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 12" StrokeThickness="0" Margin="0,0,8,0">
                        <Label Text="🔍" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Grid Grid.Column="2" WidthRequest="44" HeightRequest="44">
                        <Border BackgroundColor="{StaticResource LightBlueBg}" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                            <Label Text="⚙️" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <!-- Pastille orange notif -->
                        <Border BackgroundColor="{StaticResource OrangeWarning}" WidthRequest="10" HeightRequest="10" StrokeShape="RoundRectangle 5" StrokeThickness="2" Stroke="White" HorizontalOptions="End" VerticalOptions="Start" Margin="2" />
                    </Grid>
                </Grid>

                <!-- ONGLETS (Tabs) -->
                <Border BackgroundColor="{StaticResource CardBg}" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" Padding="4">
                    <Grid ColumnDefinitions="*, *, *">
                        <!-- Actif : À venir -->
                        <Border Grid.Column="0" BackgroundColor="{StaticResource PrimaryBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="0,10">
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                                <Label Text="À venir" TextColor="White" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                <Border BackgroundColor="White" WidthRequest="18" HeightRequest="18" StrokeShape="RoundRectangle 9" StrokeThickness="0">
                                    <Label Text="2" TextColor="{StaticResource PrimaryBlue}" FontAttributes="Bold" FontSize="10" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </HorizontalStackLayout>
                        </Border>
                        <!-- Inactif : Terminées -->
                        <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                            <Label Text="Terminées" TextColor="{StaticResource TextDark}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Text="(5)" TextColor="{StaticResource TextGray}" FontSize="12" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <!-- Inactif : Annulées -->
                        <HorizontalStackLayout Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                            <Label Text="Annulées" TextColor="{StaticResource TextGray}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Text="(1)" TextColor="{StaticResource TextGray}" FontSize="12" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- BANNIÈRE ENCOURAGEMENT -->
                <Border BackgroundColor="{StaticResource LightBlueBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16">
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Text="✨" FontSize="18" Margin="0,0,12,0" VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Progrès régulier garanti" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextDark}" />
                            <Label Text="Chaque séance consolide ta confiance. Pense à préparer tes questions avant l'heure d'étude !" FontSize="12" TextColor="{StaticResource TextGray}" LineHeight="1.3" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- CARTE SÉANCE 1 : EN ATTENTE (Bordure Orange) -->
                <Border BackgroundColor="{StaticResource CardBg}" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 16">
                    <Grid>
                        <!-- Liseré de couleur à gauche -->
                        <BoxView Color="{StaticResource OrangeWarning}" WidthRequest="4" HorizontalOptions="Start" />
                        
                        <VerticalStackLayout Padding="16,16,16,16" Spacing="16">
                            <!-- En-tête carte -->
                            <Grid ColumnDefinitions="*, Auto">
                                <Border BackgroundColor="#FEF3C7" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4" HorizontalOptions="Start">
                                    <HorizontalStackLayout Spacing="4"><Label Text="🕒" FontSize="10"/><Label Text="En attente de confirmation" TextColor="#B45309" FontSize="11" FontAttributes="Bold"/></HorizontalStackLayout>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="{StaticResource LightBlueBg}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4">
                                    <HorizontalStackLayout Spacing="4"><Label Text="📅" FontSize="10"/><Label Text="Demain à 15:00" TextColor="{StaticResource PrimaryBlue}" FontSize="11" FontAttributes="Bold"/></HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Tuteur Info -->
                            <Grid ColumnDefinitions="Auto, *">
                                <Grid WidthRequest="44" HeightRequest="44" Margin="0,0,12,0">
                                    <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" StrokeThickness="0" BackgroundColor="#E5E7EB"><Label Text="👨" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/></Border>
                                    <Border WidthRequest="16" HeightRequest="16" BackgroundColor="{StaticResource GreenSuccess}" Stroke="White" StrokeThickness="2" StrokeShape="RoundRectangle 8" HorizontalOptions="End" VerticalOptions="End"><Label Text="✓" TextColor="White" FontSize="8" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" /></Border>
                                </Grid>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="Thomas D." FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextDark}" />
                                        <Border BackgroundColor="{StaticResource GreenSuccess}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="6,2"><Label Text="Tuteur vérifié" TextColor="White" FontSize="9" FontAttributes="Bold" /></Border>
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="📐" FontSize="12"/><Label Text="Mathématiques - Lycée (Terminale)" FontSize="12" TextColor="{StaticResource TextGray}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Détails Lieu & Heure -->
                            <Border BackgroundColor="#F9FAFB" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <Label Text="📅" FontSize="14" Margin="0,0,8,0" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="Mercredi 14 Octobre • 15h30 - 16h30" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextDark}" VerticalOptions="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto, *">
                                        <Label Text="📍" FontSize="14" Margin="0,0,8,0" VerticalOptions="Start" />
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="Médiathèque Violette Leduc" FontSize="13" TextColor="{StaticResource TextDark}" />
                                            <Label Text="Salle d'étude 2 (1er étage) • Paris 11e" FontSize="12" TextColor="{StaticResource TextGray}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Message sécurité -->
                            <Border BackgroundColor="{StaticResource LightBlueBg}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Label Text="🛡️" FontSize="14" TextColor="{StaticResource PrimaryBlue}" Margin="0,0,8,0" VerticalOptions="Start" />
                                    <Label Grid.Column="1" Text="Lieu public d'apprentissage validé par la charte de sécurité." FontSize="11" TextColor="{StaticResource TextGray}" LineHeight="1.3" />
                                </Grid>
                            </Border>

                            <!-- Actions -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                <Border Grid.Column="0" BackgroundColor="{StaticResource LightBlueBg}" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="44">
                                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6"><Label Text="💬" FontSize="14"/><Label Text="Message" TextColor="{StaticResource PrimaryBlue}" FontAttributes="Bold" FontSize="13" VerticalOptions="Center"/></HorizontalStackLayout>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="#FEF2F2" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="44">
                                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6"><Label Text="📅" FontSize="14" TextColor="{StaticResource RedDanger}"/><Label Text="Annuler" TextColor="{StaticResource RedDanger}" FontAttributes="Bold" FontSize="13" VerticalOptions="Center"/></HorizontalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- CARTE SÉANCE 2 : CONFIRMÉE (Bordure Bleue) -->
                <Border BackgroundColor="{StaticResource CardBg}" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 16">
                    <Grid>
                        <BoxView Color="{StaticResource PrimaryBlue}" WidthRequest="4" HorizontalOptions="Start" />
                        <VerticalStackLayout Padding="16" Spacing="16">
                            <!-- En-tête -->
                            <Grid ColumnDefinitions="*, Auto">
                                <Border BackgroundColor="{StaticResource LightBlueBg}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4" HorizontalOptions="Start">
                                    <HorizontalStackLayout Spacing="4"><Label Text="✓" TextColor="{StaticResource PrimaryBlue}" FontSize="10" FontAttributes="Bold"/><Label Text="Confirmée par la tutrice" TextColor="{StaticResource PrimaryBlue}" FontSize="11" FontAttributes="Bold"/></HorizontalStackLayout>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="#F3F4F6" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4">
                                    <HorizontalStackLayout Spacing="4"><Label Text="⏱️" FontSize="10"/><Label Text="Dans 4 jours" TextColor="{StaticResource TextGray}" FontSize="11" FontAttributes="Bold"/></HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Tuteur -->
                            <Grid ColumnDefinitions="Auto, *">
                                <Grid WidthRequest="44" HeightRequest="44" Margin="0,0,12,0">
                                    <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" StrokeThickness="0" BackgroundColor="#E5E7EB"><Label Text="👩" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/></Border>
                                    <Border WidthRequest="16" HeightRequest="16" BackgroundColor="{StaticResource GreenSuccess}" Stroke="White" StrokeThickness="2" StrokeShape="RoundRectangle 8" HorizontalOptions="End" VerticalOptions="End"><Label Text="✓" TextColor="White" FontSize="8" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" /></Border>
                                </Grid>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="Sarah M." FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextDark}" />
                                        <Border BackgroundColor="{StaticResource GreenSuccess}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="6,2"><Label Text="Tuteur vérifié" TextColor="White" FontSize="9" FontAttributes="Bold" /></Border>
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="⚡" FontSize="12"/><Label Text="Physique-Chimie • 1ère Générale" FontSize="12" TextColor="{StaticResource TextGray}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Détails Visio -->
                            <Border BackgroundColor="#F9FAFB" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <Label Text="📅" FontSize="14" Margin="0,0,8,0" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="Samedi 17 Octobre • 10h00 - 11h00" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextDark}" VerticalOptions="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto, *">
                                        <Label Text="💻" FontSize="14" Margin="0,0,8,0" VerticalOptions="Start" />
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="En visioconférence sécurisée" FontSize="13" TextColor="{StaticResource TextDark}" />
                                            <Label Text="Lien crypté généré 15 min avant le début" FontSize="12" TextColor="{StaticResource TextGray}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Actions -->
                            <VerticalStackLayout Spacing="10">
                                <Button Text="🎥 Rejoindre la visio (bientôt actif)" BackgroundColor="{StaticResource PrimaryBlue}" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="44" />
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                    <Border Grid.Column="0" BackgroundColor="#F3F4F6" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="44">
                                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6"><Label Text="✉️" FontSize="14"/><Label Text="Contacter" TextColor="{StaticResource TextDark}" FontAttributes="Bold" FontSize="13" VerticalOptions="Center"/></HorizontalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" BackgroundColor="#F3F4F6" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="44">
                                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6"><Label Text="📅" FontSize="14"/><Label Text="Reprogrammer" TextColor="{StaticResource TextDark}" FontAttributes="Bold" FontSize="13" VerticalOptions="Center"/></HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- CARTE SÉANCE 3 : TERMINÉE (Bordure Verte) -->
                <Border BackgroundColor="{StaticResource CardBg}" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 16">
                    <Grid>
                        <BoxView Color="{StaticResource GreenSuccess}" WidthRequest="4" HorizontalOptions="Start" />
                        <VerticalStackLayout Padding="16" Spacing="16">
                            <!-- En-tête -->
                            <Grid ColumnDefinitions="*, Auto">
                                <Border BackgroundColor="#D1FAE5" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4" HorizontalOptions="Start">
                                    <HorizontalStackLayout Spacing="4"><Label Text="✓" TextColor="#065F46" FontSize="10" FontAttributes="Bold"/><Label Text="Terminée le 10 Oct." TextColor="#065F46" FontSize="11" FontAttributes="Bold"/></HorizontalStackLayout>
                                </Border>
                                <Label Grid.Column="1" Text="1h effectuée" TextColor="{StaticResource TextGray}" FontSize="12" VerticalOptions="Center" />
                            </Grid>

                            <!-- Tuteur -->
                            <Grid ColumnDefinitions="Auto, *">
                                <Grid WidthRequest="44" HeightRequest="44" Margin="0,0,12,0">
                                    <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" StrokeThickness="0" BackgroundColor="#E5E7EB"><Label Text="👨" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/></Border>
                                    <Border WidthRequest="16" HeightRequest="16" BackgroundColor="{StaticResource GreenSuccess}" Stroke="White" StrokeThickness="2" StrokeShape="RoundRectangle 8" HorizontalOptions="End" VerticalOptions="End"><Label Text="✓" TextColor="White" FontSize="8" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" /></Border>
                                </Grid>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Lucas B." FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextDark}" />
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="📘" FontSize="12"/><Label Text="Séance d'Anglais • Expression orale" FontSize="12" TextColor="{StaticResource TextGray}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Review Section -->
                            <Border BackgroundColor="#FFFBEB" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16">
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <Label Text="🤎" FontSize="16" Margin="0,0,8,0" VerticalOptions="Start" />
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="Comment s'est passée la séance ?" FontAttributes="Bold" FontSize="13" TextColor="#92400E" />
                                            <Label Text="Donnez votre avis sur cette séance pour aider Lucas et motiver la communauté !" FontSize="12" TextColor="#92400E" LineHeight="1.3" Margin="0,4,0,0"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    
                                    <!-- Etoiles -->
                                    <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8">
                                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                                            <Label Text="⭐" FontSize="20" />
                                            <Label Text="⭐" FontSize="20" />
                                            <Label Text="⭐" FontSize="20" />
                                            <Label Text="⭐" FontSize="20" />
                                            <Label Text="☆" FontSize="20" TextColor="#D1D5DB" />
                                        </HorizontalStackLayout>
                                    </Border>
                                    
                                    <Button Text="Déposer mon commentaire →" Clicked="OnNavigateToRating" BackgroundColor="#92400E" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="40" FontSize="13" />
                                </VerticalStackLayout>
                            </Border>

                            <Border BackgroundColor="#F3F4F6" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="44">
                                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6"><Label Text="🔄" FontSize="14"/><Label Text="Reprogrammer avec Lucas" TextColor="{StaticResource TextDark}" FontAttributes="Bold" FontSize="13" VerticalOptions="Center"/></HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- BANNIÈRE DE RECHERCHE -->
                <Border BackgroundColor="{StaticResource LightBlueBg}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="16">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border WidthRequest="36" HeightRequest="36" BackgroundColor="{StaticResource PrimaryBlue}" Opacity="0.1" StrokeShape="RoundRectangle 18" StrokeThickness="0" Margin="0,0,12,0" VerticalOptions="Center">
                            <Label Text="+" TextColor="{StaticResource PrimaryBlue}" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Besoin d'aide dans une autre matière ?" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextDark}" />
                            <Label Text="Plus de 45 bénévoles disponibles autour de toi" FontSize="12" TextColor="{StaticResource TextGray}" LineHeight="1.2"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="Chercher" BackgroundColor="{StaticResource PrimaryBlue}" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="36" FontSize="12" VerticalOptions="Center" Margin="8,0,0,0" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BARRE DE NAVIGATION INFÉRIEURE -->
        <Border Grid.Row="2" BackgroundColor="White" StrokeThickness="1" Stroke="#E5E7EB" Margin="-1,0,-1,-1" Padding="10,12,10,24">
            <Grid ColumnDefinitions="*, *, *, *">
                <!-- Accueil -->
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4" Opacity="0.5">
                    <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnNavigateToDashboard" /></VerticalStackLayout.GestureRecognizers>
                    <Label Text="🏠" FontSize="22" HorizontalOptions="Center" />
                    <Label Text="Accueil" TextColor="{StaticResource TextDark}" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <!-- Carte -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4" Opacity="0.5">
                    <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnNavigateToMap" /></VerticalStackLayout.GestureRecognizers>
                    <Label Text="🧭" FontSize="22" HorizontalOptions="Center" />
                    <Label Text="Carte" TextColor="{StaticResource TextDark}" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <!-- Séances (Actif) -->
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                    <Label Text="📅" FontSize="22" HorizontalOptions="Center" />
                    <Label Text="Séances" TextColor="{StaticResource PrimaryBlue}" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <!-- Profil -->
                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="4" Opacity="0.5">
                    <Label Text="👤" FontSize="22" HorizontalOptions="Center" />
                    <Label Text="Profil" TextColor="{StaticResource TextDark}" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>
</ContentPage>