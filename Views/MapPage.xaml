<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:vm="clr-namespace:TutorLocal.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TutorLocal.Views.MapPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F9FAFB">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryBlue">#5B44E9</Color>
            <Color x:Key="LightBlueBg">#EEF0FF</Color>
            <Color x:Key="TextDark">#111827</Color>
            <Color x:Key="TextGray">#6B7280</Color>
            <Color x:Key="GreenSuccess">#10B981</Color>
            <Color x:Key="OrangeAccent">#F59E0B</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- HEADER FIXE (Ligne du haut) -->
        <Grid Grid.Row="0"
                ColumnDefinitions="*, Auto, Auto"
                Padding="20,20,20,10"
                BackgroundColor="#FFFFFF">
            <Label Grid.Column="0"
                    Text="TutorLocal"
                    FontAttributes="Bold"
                    FontSize="16"
                    TextColor="{StaticResource TextDark}"
                    VerticalOptions="Center"/>

            <!-- Notification -->
            <Label Grid.Column="1"
                    Text="●"
                    FontSize="14"
                    TextColor="{StaticResource TextDark}"
                    VerticalOptions="Center"
                    Margin="0,0,16,0">
                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" /></Label.GestureRecognizers>
            </Label>

            <!-- Avatar Profil -->
            <Border Grid.Column="2"
                    WidthRequest="32"
                    HeightRequest="32"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource PrimaryBlue}"
                    VerticalOptions="Center">
                <Label Text="{Binding UserInitials}"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="12"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>
            </Border>
        </Grid>

        <!-- ZONE DE LA CARTE (Superposition d'éléments) -->
        <Grid Grid.Row="1">
            <!-- Arrière-plan simulant la carte (En prod : Microsoft.Maui.Controls.Maps.Map) -->
            <Image Source="map_background.jpg"
                    Aspect="AspectFill"
                    BackgroundColor="#E2E8F0"/>

            <!-- BARRE DE RECHERCHE ET FILTRES (Flottants en haut) -->
            <VerticalStackLayout Padding="16,16,16,0"
                    Spacing="12"
                    VerticalOptions="Start">
                <!-- Recherche -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="52"
                        Padding="16,0">
                    <Border.Shadow>
                        <Shadow Brush="#000000"
                                Offset="0,2"
                                Radius="10"
                                Opacity="0.1"/>
                    </Border.Shadow>
                    <Entry Text="{Binding SearchText, Mode=TwoWay}"
                            Placeholder="Rechercher un quartier, une matiè..."
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextDark}"
                            VerticalOptions="Center"/>
                </Border>

                <!-- Filtres rapides -->
                <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Margin="-16,0">
                    <HorizontalStackLayout Spacing="8"
                            Padding="16,0">
                        <Border BackgroundColor="{StaticResource PrimaryBlue}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                Padding="12,8">
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleDistanceFilterCommand}" /></Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="À moins de 2 km"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="13"/>
                            </HorizontalStackLayout>
                        </Border>
                        <Border BackgroundColor="White"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                Padding="12,8">
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleAvailabilityFilterCommand}" /></Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="Dispo aujourd'hui"
                                        TextColor="{StaticResource TextDark}"
                                        FontAttributes="Bold"
                                        FontSize="13"/>
                            </HorizontalStackLayout>
                        </Border>
                        <Border BackgroundColor="White"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                Padding="12,8">
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleMathFilterCommand}" /></Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="∑"
                                        FontSize="12"
                                        TextColor="{StaticResource PrimaryBlue}"/>
                                <Label Text="Maths"
                                        TextColor="{StaticResource TextDark}"
                                        FontAttributes="Bold"
                                        FontSize="13"/>
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>

            <!-- BOUTONS D'ACTION CARTE (Géolocalisation & Calques - Flottants à droite) -->
            <VerticalStackLayout VerticalOptions="Center"
                    HorizontalOptions="End"
                    Spacing="12"
                    Padding="0,0,16,0"
                    Margin="0,-60,0,0">
                <Border BackgroundColor="White"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeShape="RoundRectangle 24"
                        StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="#000000"
                                Offset="0,2"
                                Radius="8"
                                Opacity="0.15"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding FindMyLocationCommand}" /></Border.GestureRecognizers>
                    <Label Text="◎"
                            FontSize="22"
                            TextColor="{StaticResource PrimaryBlue}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
                </Border>
            </VerticalStackLayout>

            <!-- PIN DE TUTEUR SUR LA CARTE (Simulation absolue) -->
            <VerticalStackLayout HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="4"
                    Margin="40,20,0,0">
                <Grid WidthRequest="60"
                        HeightRequest="60">
                    <!-- Cercle violet d'aura -->
                    <Border BackgroundColor="{StaticResource PrimaryBlue}"
                            Opacity="0.2"
                            WidthRequest="60"
                            HeightRequest="60"
                            StrokeShape="RoundRectangle 30"
                            StrokeThickness="0"/>
                    <!-- Pastille tuteur -->
                    <Border WidthRequest="40"
                            HeightRequest="40"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="2"
                            Stroke="White"
                            BackgroundColor="{StaticResource PrimaryBlue}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
                    <Label Text="{Binding TutorInitials}"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="14"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
                </Grid>
                <!-- Label nom -->
                <Border BackgroundColor="{StaticResource PrimaryBlue}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        Padding="8,4">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="{Binding FullName}"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="11"/>
                        <Label Text="✓"
                                TextColor="White"
                                FontSize="10"/>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- PIN UTILISATEUR -->
            <VerticalStackLayout HorizontalOptions="Start"
                    VerticalOptions="End"
                    Margin="80,0,0,220"
                    Spacing="4">
                <Grid WidthRequest="32"
                        HeightRequest="32">
                    <Border BackgroundColor="{StaticResource PrimaryBlue}"
                            Opacity="0.2"
                            WidthRequest="32"
                            HeightRequest="32"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="0"/>
                    <Border WidthRequest="16"
                            HeightRequest="16"
                            BackgroundColor="{StaticResource PrimaryBlue}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="White"
                            StrokeThickness="2"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
                </Grid>
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="8,4">
                    <Label Text="Vous êtes ici"
                            TextColor="{StaticResource TextDark}"
                            FontAttributes="Bold"
                            FontSize="11"/>
                </Border>
            </VerticalStackLayout>

            <!-- BOTTOM SHEET : DÉTAILS DU TUTEUR SELECTIONNÉ -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    VerticalOptions="End"
                    Margin="16,0,16,16"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000"
                            Offset="0,4"
                            Radius="20"
                            Opacity="0.1"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <!-- Poignée de la BottomSheet -->
                    <BoxView Color="#E5E7EB"
                            HeightRequest="4"
                            WidthRequest="40"
                            CornerRadius="2"
                            HorizontalOptions="Center"
                            Margin="0,-8,0,8"/>

                    <!-- Header Tuteur -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Grid WidthRequest="60"
                                HeightRequest="60"
                                Margin="0,0,16,0">
                            <Border WidthRequest="60"
                                    HeightRequest="60"
                                    StrokeShape="RoundRectangle 30"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource PrimaryBlue}"/>
                            <Label Text="{Binding TutorInitials}"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>
                            <Border WidthRequest="16"
                                    HeightRequest="16"
                                    BackgroundColor="{StaticResource GreenSuccess}"
                                    Stroke="White"
                                    StrokeThickness="2"
                                    StrokeShape="RoundRectangle 8"
                                    HorizontalOptions="End"
                                    VerticalOptions="End"
                                    Margin="4">
                                <Label Text=""/>
                            </Border>
                        </Grid>
                        <VerticalStackLayout Grid.Column="1"
                                VerticalOptions="Center"
                                Spacing="2">
                            <Label Text="{Binding FullName}"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    TextColor="{StaticResource TextDark}"/>
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="✓"
                                        TextColor="{StaticResource GreenSuccess}"
                                        FontSize="12"/>
                                <Label Text="Tuteur Vérifié"
                                        TextColor="{StaticResource GreenSuccess}"
                                        FontAttributes="Bold"
                                        FontSize="12"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <!-- Note -->
                        <Border Grid.Column="2"
                                BackgroundColor="#FEF3C7"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="8,6"
                                VerticalOptions="Start">
                            <Label Text="{Binding RatingLabel}"
                                    TextColor="#B45309"
                                    FontAttributes="Bold"
                                    FontSize="11"/>
                        </Border>
                    </Grid>

                    <!-- Dispo -->
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="{Binding AvailabilityLabel}"
                                TextColor="{StaticResource TextDark}"
                                FontSize="14"/>
                    </HorizontalStackLayout>

                    <!-- Matières -->
                    <HorizontalStackLayout Spacing="8">
                        <Border BackgroundColor="{StaticResource LightBlueBg}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,6">
                            <Label Text="{Binding SubjectsLabel}"
                                    TextColor="{StaticResource PrimaryBlue}"
                                    FontAttributes="Bold"
                                    FontSize="12"/>
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Lieu -->
                    <Border BackgroundColor="#F3F4F6"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,12">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{Binding DistanceLabel}"
                                    TextColor="{StaticResource TextGray}"
                                    FontSize="14"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Actions -->
                    <Grid ColumnDefinitions="*, Auto"
                            ColumnSpacing="12"
                            Margin="0,4,0,0">
                        <Button Text="Voir le profil complet  →"
                                Command="{Binding ShowProfileCommand}"
                                BackgroundColor="{StaticResource PrimaryBlue}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="52"/>
                        <Border Grid.Column="1"
                                BackgroundColor="{StaticResource LightBlueBg}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                WidthRequest="52"
                                HeightRequest="52">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenChatCommand}" /></Border.GestureRecognizers>
                            <Label Text="…"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource PrimaryBlue}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>

                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Navigation inférieure, style segmented shadcn -->
        <Border Grid.Row="2" Margin="16,6,16,12" Padding="6" BackgroundColor="White" Stroke="#E4E4E7" StrokeThickness="1" StrokeShape="RoundRectangle 16">
            <Grid ColumnDefinitions="*,*,*,*">
                <Border Grid.Column="0" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="0,5">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToDashboardCommand}"/></Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="⌂" FontSize="18" TextColor="#71717A" HorizontalOptions="Center"/>
                        <Label Text="Accueil" FontSize="10" TextColor="#71717A" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="#F4F4F5" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="0,5">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="⌖" FontSize="18" TextColor="{StaticResource PrimaryBlue}" HorizontalOptions="Center"/>
                        <Label Text="Carte" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource PrimaryBlue}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="0,5">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToSessionsCommand}"/></Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="▤" FontSize="18" TextColor="#71717A" HorizontalOptions="Center"/>
                        <Label Text="Séances" FontSize="10" TextColor="#71717A" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="3" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="0,5">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToProfileCommand}"/></Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="◉" FontSize="18" TextColor="#71717A" HorizontalOptions="Center"/>
                        <Label Text="Profil" FontSize="10" TextColor="#71717A" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Border>

    </Grid>
</ContentPage>