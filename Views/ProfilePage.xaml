<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TutorLocal.ViewModels"
             x:Class="TutorLocal.Views.ProfilePage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F9FAFB">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryBlue">#5B44E9</Color>
            <Color x:Key="LightBlueBg">#EEF0FF</Color>
            <Color x:Key="TextDark">#111827</Color>
            <Color x:Key="TextGray">#6B7280</Color>
            <Color x:Key="RedDanger">#EF4444</Color>
            <Color x:Key="CardBg">#FFFFFF</Color>
            <Color x:Key="BorderColor">#E5E7EB</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- HEADER -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,20,20,10" BackgroundColor="{StaticResource CardBg}">
            <Border WidthRequest="28" HeightRequest="28" BackgroundColor="{StaticResource LightBlueBg}" StrokeShape="RoundRectangle 8" StrokeThickness="0" VerticalOptions="Center">
                <Label Text="📘" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <Label Grid.Column="1" Text="Mon Profil" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextDark}" VerticalOptions="Center" Margin="12,0,0,0" />
            <Label Grid.Column="2" Text="⚙️" FontSize="20" VerticalOptions="Center" />
        </Grid>

        <!-- CONTENU DÉFILANT -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="24">
                
                <!-- Info Utilisateur -->
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Grid WidthRequest="80" HeightRequest="80" HorizontalOptions="Center">
                        <Border WidthRequest="80" HeightRequest="80" StrokeShape="RoundRectangle 40" StrokeThickness="0" BackgroundColor="#E5E7EB">
                            <Label Text="{Binding Avatar}" FontSize="40" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Border WidthRequest="24" HeightRequest="24" BackgroundColor="{StaticResource PrimaryBlue}" Stroke="White" StrokeThickness="2" StrokeShape="RoundRectangle 12" HorizontalOptions="End" VerticalOptions="End">
                            <Label Text="✏️" TextColor="White" FontSize="10" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="{Binding FullName}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextDark}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding LevelLabel}" FontSize="14" TextColor="{StaticResource TextGray}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Statistiques -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                    <Border BackgroundColor="{StaticResource CardBg}" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" Padding="16">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="{Binding HoursLabel}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryBlue}" HorizontalTextAlignment="Center" />
                            <Label Text="Heures de cours" FontSize="12" TextColor="{StaticResource TextGray}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{StaticResource CardBg}" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" Padding="16">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="{Binding FavoriteTutors}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryBlue}" HorizontalTextAlignment="Center" />
                            <Label Text="Tuteurs favoris" FontSize="12" TextColor="{StaticResource TextGray}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Menu d'options -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Général" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextGray}" Margin="0,0,0,4" />
                    
                    <Border BackgroundColor="{StaticResource CardBg}" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" Padding="16">
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenPersonalInfoCommand}" /></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Label Text="👤" FontSize="18" Margin="0,0,12,0" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Informations personnelles" FontSize="14" TextColor="{StaticResource TextDark}" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource TextGray}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border BackgroundColor="{StaticResource CardBg}" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" Padding="16">
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenPaymentCommand}" /></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Label Text="💳" FontSize="18" Margin="0,0,12,0" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Abonnement &amp; Paiement" FontSize="14" TextColor="{StaticResource TextDark}" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource TextGray}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border BackgroundColor="{StaticResource CardBg}" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" Padding="16">
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" /></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Label Text="🔔" FontSize="18" Margin="0,0,12,0" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Notifications" FontSize="14" TextColor="{StaticResource TextDark}" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource TextGray}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Déconnexion -->
                <Border BackgroundColor="#FEF2F2" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16" Margin="0,12,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label Text="🚪" FontSize="16" VerticalOptions="Center" />
                        <Label Text="Se déconnecter" TextColor="{StaticResource RedDanger}" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BARRE DE NAVIGATION INFÉRIEURE -->
        <Border Grid.Row="2" BackgroundColor="White" StrokeThickness="1" Stroke="#E5E7EB" Margin="-1,0,-1,-1" Padding="10,12,10,24">
            <Grid ColumnDefinitions="*, *, *, *">
                <!-- Accueil -->
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4" Opacity="0.5">
                    <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToDashboardCommand}" /></VerticalStackLayout.GestureRecognizers>
                    <Label Text="🏠" FontSize="22" HorizontalOptions="Center" />
                    <Label Text="Accueil" TextColor="{StaticResource TextDark}" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <!-- Carte -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4" Opacity="0.5">
                    <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToMapCommand}" /></VerticalStackLayout.GestureRecognizers>
                    <Label Text="🧭" FontSize="22" HorizontalOptions="Center" />
                    <Label Text="Carte" TextColor="{StaticResource TextDark}" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <!-- Séances -->
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4" Opacity="0.5">
                    <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToSessionsCommand}" /></VerticalStackLayout.GestureRecognizers>
                    <Label Text="📅" FontSize="22" HorizontalOptions="Center" />
                    <Label Text="Séances" TextColor="{StaticResource TextDark}" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <!-- Profil (Actif) -->
                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="4">
                    <Label Text="👤" FontSize="22" HorizontalOptions="Center" />
                    <Label Text="Profil" TextColor="{StaticResource PrimaryBlue}" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>
</ContentPage>