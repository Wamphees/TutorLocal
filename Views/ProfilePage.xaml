<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TutorLocal.ViewModels"
             x:Class="TutorLocal.Views.ProfilePage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F9FAFB">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryBlue">#5B44E9</Color>
            <Color x:Key="LightBlueBg">#EEF0FF</Color>
            <Color x:Key="TextDark">#111827</Color>
            <Color x:Key="TextGray">#6B7280</Color>
            <Color x:Key="RedDanger">#EF4444</Color>
            <Color x:Key="CardBg">#FFFFFF</Color>
            <Color x:Key="BorderColor">#E5E7EB</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- HEADER -->
        <Label Grid.Row="0" Text="Mon Profil" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextDark}" BackgroundColor="{StaticResource CardBg}" Padding="20,20,20,10" />

        <!-- CONTENU DÉFILANT -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="24">
                
                <!-- Info Utilisateur -->
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Border WidthRequest="80" HeightRequest="80" StrokeShape="RoundRectangle 40" StrokeThickness="0" BackgroundColor="#5B44E9" HorizontalOptions="Center">
                        <Label Text="{Binding Initials}" FontSize="22" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="{Binding FullName}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextDark}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding LevelLabel}" FontSize="14" TextColor="{StaticResource TextGray}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Statistiques -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                    <Border BackgroundColor="{StaticResource CardBg}" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" Padding="16">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="{Binding HoursLabel}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryBlue}" HorizontalTextAlignment="Center" />
                            <Label Text="Heures de cours" FontSize="12" TextColor="{StaticResource TextGray}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{StaticResource CardBg}" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" Padding="16">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="{Binding FavoriteTutors}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryBlue}" HorizontalTextAlignment="Center" />
                            <Label Text="Tuteurs favoris" FontSize="12" TextColor="{StaticResource TextGray}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Menu d'options -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Général" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextGray}" Margin="0,0,0,4" />
                    
                    <Border BackgroundColor="{StaticResource CardBg}" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" Padding="16">
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenPersonalInfoCommand}" /></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Informations personnelles" FontSize="14" TextColor="{StaticResource TextDark}" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="›" FontSize="20" TextColor="{StaticResource TextGray}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border BackgroundColor="{StaticResource CardBg}" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" Padding="16">
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenPaymentCommand}" /></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Abonnement &amp; Paiement" FontSize="14" TextColor="{StaticResource TextDark}" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="›" FontSize="20" TextColor="{StaticResource TextGray}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border BackgroundColor="{StaticResource CardBg}" StrokeThickness="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" Padding="16">
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" /></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Notifications" FontSize="14" TextColor="{StaticResource TextDark}" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="›" FontSize="20" TextColor="{StaticResource TextGray}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Déconnexion -->
                <Border BackgroundColor="#FEF2F2" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16" Margin="0,12,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="Se déconnecter" TextColor="{StaticResource RedDanger}" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation inférieure, style segmented shadcn -->
        <Border Grid.Row="2" Margin="16,6,16,12" Padding="6" BackgroundColor="White" Stroke="#E4E4E7" StrokeThickness="1" StrokeShape="RoundRectangle 16">
            <Grid ColumnDefinitions="*,*,*,*">
                <Border Grid.Column="0" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="0,5">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToDashboardCommand}"/></Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="⌂" FontSize="18" TextColor="#71717A" HorizontalOptions="Center"/>
                        <Label Text="Accueil" FontSize="10" TextColor="#71717A" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="0,5">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToMapCommand}"/></Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="⌖" FontSize="18" TextColor="#71717A" HorizontalOptions="Center"/>
                        <Label Text="Carte" FontSize="10" TextColor="#71717A" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="0,5">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToSessionsCommand}"/></Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="▤" FontSize="18" TextColor="#71717A" HorizontalOptions="Center"/>
                        <Label Text="Séances" FontSize="10" TextColor="#71717A" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="3" BackgroundColor="#F4F4F5" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="0,5">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="◉" FontSize="18" TextColor="{StaticResource PrimaryBlue}" HorizontalOptions="Center"/>
                        <Label Text="Profil" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource PrimaryBlue}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Border>

    </Grid>
</ContentPage>