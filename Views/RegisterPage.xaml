<ContentPage x:Name="RootPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:vm="clr-namespace:TutorLocal.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TutorLocal.Views.RegisterPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F9FAFB">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryBlue">#5B44E9</Color>
            <Color x:Key="LightBlueBg">#EEF0FF</Color>
            <Color x:Key="TextDark">#111827</Color>
            <Color x:Key="TextGray">#6B7280</Color>
            <Color x:Key="InputBg">#F3F4F6</Color>
            <Color x:Key="BorderColor">#E5E7EB</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,40,20,30"
                Spacing="0">

            <!-- TITRES -->
            <VerticalStackLayout Spacing="12"
                    HorizontalOptions="Center"
                    Margin="0,0,0,24">
                <!-- Badge Entraide -->
                <Border BackgroundColor="{StaticResource LightBlueBg}"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        Padding="12,6"
                        HorizontalOptions="Center">
                    <Label Text="TutorLocal Entraide"
                            TextColor="{StaticResource PrimaryBlue}"
                            FontSize="12"
                            FontAttributes="Bold"/>
                </Border>

                <!-- Textes -->
                <Label Text="Rejoignez la communauté"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextDark}"
                        HorizontalTextAlignment="Center"
                        Margin="0,4,0,0"/>
                <Label Text="Créez votre profil en 1 minute pour accéder&#10;aux tuteurs près de chez vous"
                        FontSize="14"
                        TextColor="{StaticResource TextGray}"
                        HorizontalTextAlignment="Center"
                        LineHeight="1.4"/>
            </VerticalStackLayout>

            <!-- CARTE BLANCHE DU FORMULAIRE -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="#000000"
                            Offset="0,4"
                            Radius="20"
                            Opacity="0.05"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">

                    <!-- SELECTEUR ELEVE / TUTEUR -->
                    <Border BackgroundColor="{StaticResource LightBlueBg}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="4">
                        <Grid ColumnDefinitions="*,*">
                            <!-- Élève / Parent (sélection via VM) -->
                            <Border Grid.Column="0"
                                    BackgroundColor="{Binding StudentRoleBackground}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="0,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectStudentCommand}"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <Label Text="Élève / Parent"
                                            TextColor="{Binding StudentRoleText}"
                                            FontSize="13"
                                            FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                            </Border>
                            <!-- Tuteur bénévole -->
                            <Border Grid.Column="1"
                                    BackgroundColor="{Binding TutorRoleBackground}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="0,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectTutorCommand}"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <Label Text="Tuteur bénévole"
                                            TextColor="{Binding TutorRoleText}"
                                            FontSize="13"
                                            FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- BANNIERE INFO APPRENANT -->
                    <Border BackgroundColor="{StaticResource LightBlueBg}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Profil apprenant"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    TextColor="{StaticResource TextDark}"/>
                            <Label Text="Accès gratuit aux sessions d'entraide encadrées en médiathèques partenaires."
                                    FontSize="12"
                                    TextColor="{StaticResource TextGray}"
                                    LineHeight="1.3"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- CHAMP : NOM -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Nom complet"
                                FontAttributes="Bold"
                                FontSize="13"
                                TextColor="{StaticResource TextDark}"/>
                        <Border BackgroundColor="{StaticResource InputBg}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                HeightRequest="48"
                                Padding="12,0">
                            <Entry Placeholder="ex. Alex Dupont"
                                    Text="{Binding FullName}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource TextDark}"
                                    VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- CHAMP : EMAIL -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Email académique ou personnel"
                                FontAttributes="Bold"
                                FontSize="13"
                                TextColor="{StaticResource TextDark}"/>
                        <Border BackgroundColor="{StaticResource InputBg}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                HeightRequest="48"
                                Padding="12,0">
                            <Entry Placeholder="alex@exemple.fr"
                                    Keyboard="Email"
                                    Text="{Binding Email}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource TextDark}"
                                    VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- CHAMP : MOT DE PASSE -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Mot de passe"
                                FontAttributes="Bold"
                                FontSize="13"
                                TextColor="{StaticResource TextDark}"/>
                        <Border BackgroundColor="{StaticResource InputBg}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                HeightRequest="48"
                                Padding="12,0">
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry VerticalOptions="Center"
                                        Placeholder="••••••••"
                                        IsPassword="{Binding IsPasswordHidden}"
                                        Text="{Binding Password}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextDark}"/>
                                <Label Grid.Column="1"
                                        Text="{Binding TogglePasswordText}"
                                        TextColor="{StaticResource PrimaryBlue}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        Padding="8,0"
                                        VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding TogglePasswordCommand}"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- NIVEAU SCOLAIRE -->
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Niveau scolaire actuel"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    TextColor="{StaticResource TextDark}"/>
                            <Label Grid.Column="1"
                                    Text="Obligatoire"
                                    FontSize="12"
                                    TextColor="{StaticResource PrimaryBlue}"
                                    FontAttributes="Bold"/>
                        </Grid>
                        <Grid ColumnDefinitions="*, *, *"
                                ColumnSpacing="8"
                                BindableLayout.ItemsSource="{Binding Levels}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{Binding BackgroundColor}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="0,10">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.SelectLevelCommand}" CommandParameter="{Binding}"/>
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Label}"
                                                TextColor="{Binding TextColor}"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                HorizontalOptions="Center"/>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- CHECKBOX CONDITIONS -->
                    <Grid ColumnDefinitions="Auto, *"
                            Margin="0,4,0,0"
                            ColumnSpacing="12">
                        <CheckBox Color="{StaticResource PrimaryBlue}"
                                VerticalOptions="Start"
                                IsChecked="{Binding TermsAccepted, Mode=TwoWay}"/>
                        <Label Grid.Column="1"
                                FontSize="13"
                                TextColor="{StaticResource TextGray}"
                                LineHeight="1.3"
                                VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="J'accepte la "/>
                                    <Span Text="charte d'entraide bienveillante"
                                            TextColor="{StaticResource PrimaryBlue}"
                                            TextDecorations="Underline">
                                        <Span.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ViewTermsCommand}"/>
                                        </Span.GestureRecognizers>
                                    </Span>
                                    <Span Text=" et les conditions d'utilisation."/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                    <!-- MESSAGE D'ERREUR (=validations du VM) -->
                    <Label Text="{Binding ErrorMessage}"
                            TextColor="#B91C1C"
                            FontSize="13"
                            IsVisible="{Binding HasError}"
                            Margin="0,4,0,0"/>

                    <!-- BOUTON SUBMIT -->
                    <Button Text="S'inscrire gratuitement"
                            Command="{Binding RegisterCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="{StaticResource PrimaryBlue}"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="52"
                            FontAttributes="Bold"
                            FontSize="15"
                            Margin="0,8,0,0"/>

                    <!-- SEPARATEUR OU -->
                    <Grid ColumnDefinitions="*, Auto, *"
                            VerticalOptions="Center"
                            Margin="0,4">
                        <BoxView HeightRequest="1"
                                Color="{StaticResource BorderColor}"
                                VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                                Text="ou continuer avec"
                                TextColor="{StaticResource TextGray}"
                                FontSize="13"
                                Margin="12,0"/>
                        <BoxView Grid.Column="2"
                                HeightRequest="1"
                                Color="{StaticResource BorderColor}"
                                VerticalOptions="Center"/>
                    </Grid>

                    <!-- BOUTON GOOGLE -->
                    <Border Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 12"
                            HeightRequest="52">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoogleRegisterCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="Continuer avec Google"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                TextColor="{StaticResource TextDark}"
                                FontAttributes="Bold"
                                FontSize="14"/>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- BADGE GARANTIE (Hors de la carte) -->
            <Border BackgroundColor="{StaticResource LightBlueBg}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    Margin="0,24,0,24">
                <VerticalStackLayout Spacing="2"
                        VerticalOptions="Center">
                    <Label Text="Garantie neutralité &amp; gratuité"
                            FontAttributes="Bold"
                            FontSize="12"
                            TextColor="#059669"/>
                    <Label Text="Partenariat avec les collèges &amp; médiathèques"
                            FontSize="11"
                            TextColor="{StaticResource TextGray}"/>
                </VerticalStackLayout>
            </Border>

            <!-- FOOTER LOGIN -->
            <HorizontalStackLayout HorizontalOptions="Center"
                    Spacing="6">
                <Label Text="Vous avez déjà un compte ?"
                        TextColor="{StaticResource TextGray}"
                        FontSize="14"/>
                <Label Text="Se connecter"
                        TextColor="{StaticResource PrimaryBlue}"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToLoginCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>