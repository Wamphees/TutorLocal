<ContentPage x:Name="RootPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TutorLocal.ViewModels"
             x:Class="TutorLocal.Views.DashboardPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F9FAFB">

        <ContentPage.Resources>
                <ResourceDictionary>
                        <Color x:Key="PrimaryBlue">#4338CA</Color>
                        <Color x:Key="LightBlue">#EEF2FF</Color>
                        <Color x:Key="TextDark">#111827</Color>
                        <Color x:Key="TextGray">#6B7280</Color>
                        <Color x:Key="CardBg">#FFFFFF</Color>
                        <Color x:Key="OrangeAccent">#F59E0B</Color>
                        <Color x:Key="GreenSuccess">#10B981</Color>
                </ResourceDictionary>
        </ContentPage.Resources>

        <Grid RowDefinitions="Auto, *, Auto">

                <!-- HEADER FIXE (Ligne du haut) -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="*, Auto"
                      Padding="20,20,20,10"
                      BackgroundColor="#F9FAFB">
                        <Label Text="TutorLocal"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="{StaticResource TextDark}"
                               VerticalOptions="Center"/>

                        <!-- Notifications -->
                        <Label Grid.Column="1"
                               Text="Notifications"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextGray}"
                               VerticalOptions="Center">
                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" /></Label.GestureRecognizers>
                        </Label>
                </Grid>

                <!-- CONTENU DÉFILANT -->
                <ScrollView Grid.Row="1">
                        <VerticalStackLayout Padding="20,10,20,40"
                                             Spacing="24">

                                <!-- MESSAGE DE BIENVENUE & BARRE DE RECHERCHE -->
                                <VerticalStackLayout Spacing="16">
                                        <Grid ColumnDefinitions="*, Auto">
                                                <VerticalStackLayout>
                                                        <Label Text="{Binding UserFirstName, StringFormat='Bonjour, {0}'}"
                                                               FontSize="26"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource TextDark}"/>
                                                        <Label Text="Prêt pour réviser&#10;aujourd'hui ?"
                                                               FontSize="15"
                                                               TextColor="{StaticResource TextGray}"
                                                               LineHeight="1.3"/>
                                                </VerticalStackLayout>

                                                <!-- Bulle Notification Flottante -->
                                                <Grid Grid.Column="1"
                                                      VerticalOptions="Start"
                                                      WidthRequest="44"
                                                      HeightRequest="44">
                                                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" /></Grid.GestureRecognizers>
                                                        <Border BackgroundColor="{StaticResource LightBlue}"
                                                                StrokeShape="RoundRectangle 22"
                                                                StrokeThickness="0"/>
                                                        <Border WidthRequest="10"
                                                                HeightRequest="10"
                                                                BackgroundColor="#EF4444"
                                                                StrokeShape="RoundRectangle 5"
                                                                StrokeThickness="2"
                                                                Stroke="White"
                                                                HorizontalOptions="End"
                                                                VerticalOptions="Start"
                                                                Margin="0,4,4,0"/>
                                                </Grid>
                                        </Grid>

                                        <!-- Barre de recherche -->
                                        <Border BackgroundColor="White"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 16"
                                                HeightRequest="52"
                                                Padding="16,0">
                                                <Entry Text="{Binding SearchText, Mode=OneWayToSource}"
                                                        Placeholder="Quelle matière voulez-vous réviser"
                                                       BackgroundColor="Transparent"
                                                       TextColor="{StaticResource TextDark}"
                                                       VerticalOptions="Center"/>
                                        </Border>

                                        <!-- Filtres (Pills) - data-binds vers SubjectFilters -->
                                        <ScrollView Orientation="Horizontal"
                                                    HorizontalScrollBarVisibility="Never">
                                                <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding SubjectFilters}">
                                                        <BindableLayout.ItemTemplate>
                                                                <DataTemplate>
                                                                        <Border BackgroundColor="{Binding BackgroundColor}"
                                                                                StrokeThickness="1"
                                                                                Stroke="#E5E7EB"
                                                                                StrokeShape="RoundRectangle 16"
                                                                                Padding="16,8">
                                                                                <Border.GestureRecognizers>
                                                                                        <TapGestureRecognizer Command="{Binding SelectCommand}"/>
                                                                                </Border.GestureRecognizers>
                                                                                <Label Text="{Binding Label}"
                                                                                       TextColor="{Binding TextColor}"
                                                                                       FontAttributes="Bold"
                                                                                       FontSize="13"/>
                                                                        </Border>
                                                                </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                </HorizontalStackLayout>
                                        </ScrollView>
                                </VerticalStackLayout>

                                <!-- CARTE HERO : DEMANDE EXPRESS -->
                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 20"
                                        Padding="20">
                                        <Border.Background>
                                                <LinearGradientBrush EndPoint="1,1">
                                                        <GradientStop Color="#5B44E9"
                                                                      Offset="0.0"/>
                                                        <GradientStop Color="#3B28CC"
                                                                      Offset="1.0"/>
                                                </LinearGradientBrush>
                                        </Border.Background>
                                        <VerticalStackLayout Spacing="16">
                                                <Border BackgroundColor="#4B3ED7"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 12"
                                                        Padding="8,4"
                                                        HorizontalOptions="Start">
                                                        <Label Text="Entraide solidaire"
                                                               TextColor="White"
                                                               FontSize="11"
                                                               FontAttributes="Bold"/>
                                                </Border>

                                                <Label Text="Demande d'aide&#10;express"
                                                       FontSize="22"
                                                       FontAttributes="Bold"
                                                       TextColor="White"
                                                       LineHeight="1.2"/>
                                                <Label Text="Un devoir urgent pour demain ? Notifiez les&#10;tuteurs bénévoles disponibles dans votre&#10;quartier."
                                                       FontSize="13"
                                                       TextColor="#D1D5DB"
                                                       LineHeight="1.4"/>

                                                <Button Text="Créer une demande"
                                                        BackgroundColor="{StaticResource OrangeAccent}"
                                                        TextColor="White"
                                                        FontAttributes="Bold"
                                                        Command="{Binding CreateRequestCommand}"
                                                        CornerRadius="12"
                                                        HeightRequest="48"
                                                        Margin="0,8,0,0"/>
                                        </VerticalStackLayout>
                                </Border>

                                <!-- CARTE : RAPPEL DE RÉVISION (prochaine séance) -->
                                <VerticalStackLayout Spacing="12" IsVisible="{Binding HasNextSession}">
                                        <Grid ColumnDefinitions="*, Auto">
                                                <Label Text="Rappel de révision"
                                                       FontAttributes="Bold"
                                                       FontSize="16"
                                                       TextColor="{StaticResource TextDark}"
                                                       VerticalOptions="Center"/>
                                                <Border Grid.Column="1"
                                                        BackgroundColor="#FEF3C7"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 8"
                                                        Padding="8,4">
                                                        <Label Text="{Binding NextSessionStatusLabel}"
                                                               TextColor="#B45309"
                                                               FontSize="11"
                                                               FontAttributes="Bold"/>
                                                </Border>
                                        </Grid>

                                        <Border BackgroundColor="White"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 16"
                                                Padding="16">
                                                <VerticalStackLayout Spacing="12">
                                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                                                <!-- Avatar initiales -->
                                                                <Grid WidthRequest="44"
                                                                      HeightRequest="44"
                                                                      Margin="0,0,12,0">
                                                                        <Border WidthRequest="44"
                                                                                HeightRequest="44"
                                                                                StrokeShape="RoundRectangle 22"
                                                                                StrokeThickness="0"
                                                                                BackgroundColor="#5B44E9"/>
                                                                        <Label Text="{Binding NextSessionTutorInitials}"
                                                                               TextColor="White"
                                                                               FontAttributes="Bold"
                                                                               FontSize="15"
                                                                               HorizontalOptions="Center"
                                                                               VerticalOptions="Center"/>
                                                                        <Border WidthRequest="16"
                                                                                HeightRequest="16"
                                                                                BackgroundColor="{StaticResource GreenSuccess}"
                                                                                Stroke="White"
                                                                                StrokeThickness="2"
                                                                                StrokeShape="RoundRectangle 8"
                                                                                HorizontalOptions="End"
                                                                                VerticalOptions="End">
                                                                                <Label Text="✓"
                                                                                       TextColor="White"
                                                                                       FontSize="8"
                                                                                       FontAttributes="Bold"
                                                                                       HorizontalOptions="Center"
                                                                                       VerticalOptions="Center"/>
                                                                        </Border>
                                                                </Grid>
                                                                <!-- Info -->
                                                                <VerticalStackLayout Grid.Column="1"
                                                                                     VerticalOptions="Center">
                                                                        <Label Text="{Binding NextSessionTutorName}"
                                                                               FontAttributes="Bold"
                                                                               FontSize="15"
                                                                               TextColor="{StaticResource TextDark}"/>
                                                                        <Label Text="{Binding NextSessionTutorSubject}"
                                                                               FontSize="13"
                                                                               TextColor="{StaticResource TextGray}"/>
                                                                </VerticalStackLayout>
                                                                <!-- Heure -->
                                                                <Border Grid.Column="2"
                                                                        BackgroundColor="{StaticResource LightBlue}"
                                                                        StrokeThickness="0"
                                                                        StrokeShape="RoundRectangle 8"
                                                                        Padding="8,6"
                                                                        VerticalOptions="Center">
                                                                        <Label Text="{Binding NextSessionTimeBadge}"
                                                                               TextColor="{StaticResource PrimaryBlue}"
                                                                               FontSize="12"
                                                                               FontAttributes="Bold"/>
                                                                </Border>
                                                        </Grid>

                                                        <!-- Lieu -->
                                                        <Border BackgroundColor="#F3F4F6"
                                                                StrokeThickness="0"
                                                                StrokeShape="RoundRectangle 8"
                                                                Padding="12,8">
                                                                <Label Text="{Binding NextSessionPlace}"
                                                                       FontSize="13"
                                                                       TextColor="{StaticResource TextDark}"/>
                                                        </Border>

                                                        <!-- Footer Carte -->
                                                        <Grid ColumnDefinitions="*, Auto"
                                                              Margin="0,4,0,0">
                                                                <Label Text="{Binding NextSessionCountdown}"
                                                                       TextColor="#B45309"
                                                                       FontAttributes="Bold"
                                                                       FontSize="12"
                                                                       VerticalOptions="Center"/>
                                                                <Label Grid.Column="1" Text="Détails · Chat" TextColor="{StaticResource PrimaryBlue}" FontAttributes="Bold" FontSize="13">
    <Label.GestureRecognizers>
        <TapGestureRecognizer Command="{Binding OpenChatCommand}" />
    </Label.GestureRecognizers>
</Label>
                                                        </Grid>
                                                </VerticalStackLayout>
                                        </Border>
                                </VerticalStackLayout>

                                <!-- SECTION : TUTEURS À PROXIMITÉ (Carrousel) -->
                                <VerticalStackLayout Spacing="12">
                                        <Grid ColumnDefinitions="*, Auto">
                                                <VerticalStackLayout>
                                                        <Label Text="Tuteurs à proximité"
                                                               FontAttributes="Bold"
                                                               FontSize="18"
                                                               TextColor="{StaticResource TextDark}"/>
                                                        <Label Text="Paris 11e · Rayon 3 km"
                                                               FontSize="13"
                                                               TextColor="{StaticResource TextGray}"/>
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1"
                                                       Text="Voir sur la carte >"
                                                       TextColor="{StaticResource PrimaryBlue}"
                                                       FontAttributes="Bold"
                                                       FontSize="13"
                                                       VerticalOptions="Center">
                                                        <Label.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding OpenMapCommand}" />
                                                        </Label.GestureRecognizers>
                                                </Label>
                                        </Grid>

                                        <ScrollView Orientation="Horizontal"
                                            HorizontalScrollBarVisibility="Never"
                                            Margin="-20,0">
                                        <HorizontalStackLayout Spacing="16"
                                                               Padding="20,0"
                                                               BindableLayout.ItemsSource="{Binding Tutors}">
                                                <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                                <!-- Carte Tuteur (data-driven) -->
                                                                <Border BackgroundColor="White"
                                                                        StrokeThickness="0"
                                                                        StrokeShape="RoundRectangle 16"
                                                                        Padding="16"
                                                                        WidthRequest="240">
                                                                        <Border.Shadow>
                                                                                <Shadow Brush="#000000"
                                                                                        Offset="0,2"
                                                                                        Radius="10"
                                                                                        Opacity="0.05"/>
                                                                        </Border.Shadow>
                                                                        <Border.GestureRecognizers>
                                                                                <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.OpenTutorCardCommand}" CommandParameter="{Binding}" />
                                                                        </Border.GestureRecognizers>

                                                                        <VerticalStackLayout Spacing="10">
                                                                                <Grid ColumnDefinitions="*, Auto">
                                                                                        <!-- Avatar -->
                                                                                        <Grid WidthRequest="50"
                                                                                              HeightRequest="50"
                                                                                              HorizontalOptions="Start">
                                                                                                <Border WidthRequest="50"
                                                                                                        HeightRequest="50"
                                                                                                        StrokeShape="RoundRectangle 25"
                                                                                                        StrokeThickness="0"
                                                                                                        BackgroundColor="#5B44E9">
                                                                                                        <Label Text="{Binding Tutor.Initials}"
                                                                                                               TextColor="White"
                                                                                                               FontAttributes="Bold"
                                                                                                               FontSize="18"
                                                                                                               HorizontalOptions="Center"
                                                                                                               VerticalOptions="Center"/>
                                                                                                </Border>
                                                                                                <Border WidthRequest="18"
                                                                                                        HeightRequest="18"
                                                                                                        BackgroundColor="{StaticResource GreenSuccess}"
                                                                                                        Stroke="White"
                                                                                                        StrokeThickness="2"
                                                                                                        StrokeShape="RoundRectangle 9"
                                                                                                        HorizontalOptions="End"
                                                                                                        VerticalOptions="End">
                                                                                                        <Label Text="✓"
                                                                                                               TextColor="White"
                                                                                                               FontSize="10"
                                                                                                               FontAttributes="Bold"
                                                                                                               HorizontalOptions="Center"
                                                                                                               VerticalOptions="Center"/>
                                                                                                </Border>
                                                                                        </Grid>
                                                                                        <!-- Note -->
                                                                                        <Border Grid.Column="1"
                                                                                                BackgroundColor="#F9FAFB"
                                                                                                StrokeThickness="1"
                                                                                                Stroke="#E5E7EB"
                                                                                                StrokeShape="RoundRectangle 12"
                                                                                                Padding="6,4"
                                                                                                VerticalOptions="Start">
                                                                                                <HorizontalStackLayout Spacing="4">
                                                                                                        <Label Text="★"
                                                                                                               FontSize="10"
                                                                                                               TextColor="{StaticResource OrangeAccent}"
                                                                                                               VerticalOptions="Center"/>
                                                                                                        <Label Text="{Binding RatingLabel}"
                                                                                                               FontAttributes="Bold"
                                                                                                               FontSize="11"
                                                                                                               TextColor="{StaticResource TextDark}"
                                                                                                               VerticalOptions="Center"/>
                                                                                                </HorizontalStackLayout>
                                                                                        </Border>
                                                                                </Grid>

                                                                                <!-- Info Tuteur -->
                                                                                <HorizontalStackLayout Spacing="8"
                                                                                                       Margin="0,4,0,0">
                                                                                        <Label Text="{Binding FullName}"
                                                                                               FontAttributes="Bold"
                                                                                               FontSize="16"
                                                                                               TextColor="{StaticResource TextDark}"/>
                                                                                        <Border BackgroundColor="{StaticResource GreenSuccess}"
                                                                                                StrokeThickness="0"
                                                                                                StrokeShape="RoundRectangle 10"
                                                                                                Padding="6,2"
                                                                                                VerticalOptions="Center">
                                                                                                <Label Text="Vérifié"
                                                                                                       TextColor="White"
                                                                                                       FontSize="9"
                                                                                                       FontAttributes="Bold"/>
                                                                                        </Border>
                                                                                </HorizontalStackLayout>

                                                                                <Label Text="{Binding DistanceLabel}"
                                                                                       FontSize="13"
                                                                                       TextColor="{StaticResource TextGray}"/>

                                                                                <!-- Matières -->
                                                                                <HorizontalStackLayout Spacing="6"
                                                                                                       BindableLayout.ItemsSource="{Binding Subjects}">
                                                                                        <BindableLayout.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                        <Border BackgroundColor="#F3F4F6"
                                                                                                                StrokeThickness="0"
                                                                                                                StrokeShape="RoundRectangle 8"
                                                                                                                Padding="6,4">
                                                                                                                <Label Text="{Binding Name}"
                                                                                                                       FontSize="11"
                                                                                                                       FontAttributes="Bold"
                                                                                                                       TextColor="{StaticResource TextDark}"/>
                                                                                                        </Border>
                                                                                                </DataTemplate>
                                                                                        </BindableLayout.ItemTemplate>
                                                                                </HorizontalStackLayout>

                                                                                <Label Text="Gratuit (Bénévole)"
                                                                                       TextColor="{StaticResource GreenSuccess}"
                                                                                       FontAttributes="Bold"
                                                                                       FontSize="13"
                                                                                       Margin="0,4,0,0"/>

                                                                                <Button Text="Demander un cours"
                                                                                        BackgroundColor="{StaticResource PrimaryBlue}"
                                                                                        Command="{Binding RequestCourseCommand}"
                                                                                        TextColor="White"
                                                                                        FontAttributes="Bold"
                                                                                        CornerRadius="10"
                                                                                        HeightRequest="44"
                                                                                        Margin="0,8,0,0"/>
                                                                        </VerticalStackLayout>
                                                                </Border>
                                                        </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                        </HorizontalStackLayout>
                                </ScrollView>
                                </VerticalStackLayout>

                                <!-- BANNIÈRE SÉCURITÉ BAS DE PAGE -->
                                <Border BackgroundColor="White"
                                        StrokeThickness="1"
                                        Stroke="#E5E7EB"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="16"
                                        Margin="0,10,0,0">
                                        <VerticalStackLayout Spacing="2">
                                                <Label Text="Sécurité &amp; Lieux publics"
                                                       FontAttributes="Bold"
                                                       FontSize="13"
                                                       TextColor="{StaticResource TextDark}"/>
                                                <Label Text="Toutes les séances ont lieu dans des espaces publics vérifiés (médiathèques, centres d'animation) pour un cadre 100% sécurisant."
                                                       FontSize="12"
                                                       TextColor="{StaticResource TextGray}"
                                                       LineHeight="1.3"/>
                                        </VerticalStackLayout>
                                </Border>

                        </VerticalStackLayout>
                </ScrollView>

                <!-- BARRE DE NAVIGATION INFÉRIEURE (Tab Bar Fake pour la maquette) -->
                <Border Grid.Row="2"
                        BackgroundColor="White"
                        StrokeThickness="1"
                        Stroke="#E5E7EB"
                        Margin="-1,0,-1,-1"
                        Padding="10,12,10,24">
                        <Grid ColumnDefinitions="*, *, *, *">
                                <!-- Accueil (Actif) -->
                                <VerticalStackLayout Grid.Column="0"
                                                     HorizontalOptions="Center"
                                                     Spacing="4">
                                        <Label Text="Accueil"
                                               TextColor="{StaticResource PrimaryBlue}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"/>
                                </VerticalStackLayout>

                                <!-- Carte -->
                                <!-- Carte -->
                                <VerticalStackLayout Grid.Column="1"
                                                     HorizontalOptions="Center"
                                                     Spacing="4"
                                                     Opacity="0.5">
                                        <VerticalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenMapCommand}"/>
                                        </VerticalStackLayout.GestureRecognizers>
                                        <Label Text="Carte"
                                               TextColor="{StaticResource TextDark}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"/>
                                </VerticalStackLayout>

                                <!-- Séances -->
                                <VerticalStackLayout Grid.Column="2"
                                                HorizontalOptions="Center"
                                                Spacing="4"
                                                Opacity="0.5">
                                        <VerticalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenSessionsCommand}"/>
                                        </VerticalStackLayout.GestureRecognizers>
                                        <Label Text="Séances"
                                                        TextColor="{StaticResource TextDark}"
                                                        FontSize="11"
                                                        FontAttributes="Bold"
                                                        HorizontalOptions="Center"/>
                                </VerticalStackLayout>

                                <!-- Profil -->
                                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="4" Opacity="0.5">
    <VerticalStackLayout.GestureRecognizers>
        <TapGestureRecognizer Command="{Binding OpenProfileCommand}" />
    </VerticalStackLayout.GestureRecognizers>
    <Label Text="Profil" TextColor="{StaticResource TextDark}" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
</VerticalStackLayout>
                        </Grid>
                </Border>

        </Grid>
</ContentPage>